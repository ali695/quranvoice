# QuranVoice environment variables
#
# Copy this file to .env.local and paste your real values there.
# Never commit .env.local. The .gitignore in this repo already excludes it.
#
# IMPORTANT: keep "private" variables (no NEXT_PUBLIC_ prefix) server-side only.
# They are accessible only inside `app/api/**` route handlers, server components,
# and other server-side code paths. Anything with NEXT_PUBLIC_ is bundled into
# the browser and visible to anyone — only use it for non-secret values.

# ===== Quran.Foundation Content API (server-only, client_credentials) =====
# https://api-docs.quran.foundation/  — primary verified Quran source.
# The CLIENT_SECRET MUST stay server-only. Never wrap it with NEXT_PUBLIC_.
QURAN_FOUNDATION_ENV=production
QURAN_FOUNDATION_CLIENT_ID=PASTE_CLIENT_ID_HERE
QURAN_FOUNDATION_CLIENT_SECRET=PASTE_CLIENT_SECRET_HERE
QURAN_FOUNDATION_OAUTH_URL=https://oauth2.quran.foundation
QURAN_FOUNDATION_API_BASE_URL=https://apis.quran.foundation

# ===== Quran.Foundation USER auth (optional: "Sign in with Quran.Foundation") =====
# authorization_code + PKCE flow for user features (bookmark, note, collection,
# preference, streak…). Public PKCE client — the secret is OPTIONAL.
# The redirect URI MUST exactly match one registered in the Foundation console.
# These are the PRE-LIVE user-feature hosts until production user scopes land.
QURAN_FOUNDATION_USER_CLIENT_ID=
# QURAN_FOUNDATION_USER_CLIENT_SECRET=
QURAN_FOUNDATION_USER_OAUTH_URL=https://prelive-oauth2.quran.foundation
QURAN_FOUNDATION_USER_API_BASE_URL=https://apis-prelive.quran.foundation
QURAN_FOUNDATION_USER_REDIRECT_URI=https://your-domain.com/auth/callback
QURAN_FOUNDATION_USER_SCOPES=openid offline_access profile bookmark collection note preference reading_session activity_day goal streak tag

# ===== Debug routes (production) =====
# /api/debug/* are open in development. In production they 404 unless this
# token is set and supplied as ?token=...  Leave empty to keep them disabled.
QURAN_DEBUG_TOKEN=

# ===== App URL =====
# Used for absolute URLs in metadata, canonical tags, hreflang and the sitemap.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ===== Supabase (auth, settings, notes, bookmarks, progress, quizzes) =====
# Sign in at https://supabase.com → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=PASTE_SUPABASE_PROJECT_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_OR_PUBLISHABLE_KEY_HERE
# Service role bypasses RLS — server-only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE

# ===== Tafsir fallback (spa5k/tafsir_api) — SECONDARY source only =====
# Quran.Foundation stays primary; this is used only when QF has no tafsir for a
# verse/language. Self-host the data folder before production rollout if desired.
TAFSIR_FALLBACK_ENABLED=true
TAFSIR_FALLBACK_BASE_URL=https://cdn.jsdelivr.net/gh/spa5k/tafsir_api@main/tafsir

# ===== Asbab / Shan-e-Nuzool source (Arabic, optional) =====
# Arabic Asbab/Shan-e-Nuzool dataset. Displayed only after review.
ASBAB_DB_ENABLED=false
ASBAB_DB_PATH=server-data/ar.asbabnozul.db

# ===== Locales =====
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ar,ur,hi,bn,id,tr,de,fr,es,it,ru,fa,ms,zh,ja,ko
